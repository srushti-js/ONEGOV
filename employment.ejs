<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Employment Exchange Board</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body class="portal-page">

  <div class="portal-container">

    <div class="portal-header">
      <h1>Employment Exchange Board</h1>
      <p>Verified citizen employment information</p>
      <span class="status">● Employment Verified</span>
    </div>

    <div class="data-card">
      <h2>Employment Information</h2>

      <div class="data-row">
        <span class="data-label">Employment Status</span>
        <strong class="data-value">
          <%= citizen.employment.status || "Not Available" %>
        </strong>
      </div>

      <div class="data-row">
        <span class="data-label">Employer Name</span>
        <strong class="data-value">
          <%= citizen.employment.employerName || "Not Available" %>
        </strong>
      </div>

      <div class="data-row">
        <span class="data-label">Occupation</span>
        <strong class="data-value">
          <%= citizen.employment.occupation || "Not Available" %>
        </strong>
      </div>

    </div>

    <div class="data-card">
      <h3>Employment information verified successfully. ✅</h3>
      <p>This information has been retrieved from the verified government profile.</p>

      <a href="/dashboard?nationalId=<%= citizen.nationalId %>" class="back-btn">
        ← Back to Dashboard
      </a>
    </div>

  </div>

</body>
</html>