<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Welfare & Caste Certificate Portal</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body class="portal-page">

  <div class="portal-container">

    <div class="portal-header">
      <h1>Social Welfare & Caste Certificate Portal</h1>
      <p>Verified citizen caste certificate information</p>
      <span class="status">● Caste Certificate Verified</span>
    </div>

    <div class="data-card">
      <h2>Caste Information</h2>

      <div class="data-row">
        <span class="data-label">Category</span>
        <strong class="data-value">
          <%= citizen.caste.category || "Not Available" %>
        </strong>
      </div>

      <div class="data-row">
        <span class="data-label">Certificate Number</span>
        <strong class="data-value">
          <%= citizen.caste.certificateNumber || "Not Available" %>
        </strong>
      </div>

      <div class="data-row">
        <span class="data-label">Issued Date</span>
        <strong class="data-value">
          <%= citizen.caste.issuedDate ? new Date(citizen.caste.issuedDate).toLocaleDateString() : "Not Available" %>
        </strong>
      </div>

    </div>

    <div class="data-card">
      <h3>Caste certificate verified successfully. ✅</h3>
      <p>This information has been retrieved from the verified government profile.</p>

      <a href="/dashboard?nationalId=<%= citizen.nationalId %>" class="back-btn">
        ← Back to Dashboard
      </a>
    </div>

  </div>

</body>
</html>